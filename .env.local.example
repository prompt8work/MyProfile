# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# From sanity.io/manage → your project → Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version — a fixed date pins query behavior; bump deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# From sanity.io/manage → your project → API → Tokens → Editor permission.
# Server-only: never referenced from a Client Component. Needed once
# draft/preview mode and the revalidation webhook are wired up.
SANITY_API_TOKEN=
